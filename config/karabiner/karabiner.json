{
    "global": { "show_in_menu_bar": false },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Ctrl+Space: SKK -> UnicodeHexInput",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "input_sources": [{ "input_source_id": "^net\\.mtgto\\.inputmethod\\.macSKK\\." }],
                                        "type": "input_source_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "spacebar",
                                    "modifiers": {
                                        "mandatory": ["control"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "shell_command": "/opt/homebrew/bin/macism com.apple.keylayout.UnicodeHexInput" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Ctrl+Space: UnicodeHexInput -> SKK (hiragana)",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "input_sources": [{ "input_source_id": "^com\\.apple\\.keylayout\\.UnicodeHexInput$" }],
                                        "type": "input_source_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "spacebar",
                                    "modifiers": {
                                        "mandatory": ["control"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "shell_command": "/opt/homebrew/bin/macism net.mtgto.inputmethod.macSKK.hiragana" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "devices": [
                {
                    "identifiers": { "is_keyboard": true },
                    "simple_modifications": [
                        {
                            "from": { "key_code": "caps_lock" },
                            "to": [{ "key_code": "left_control" }]
                        },
                        {
                            "from": { "key_code": "left_control" },
                            "to": [{ "key_code": "caps_lock" }]
                        }
                    ]
                },
                {
                    "identifiers": {
                        "is_keyboard": true,
                        "product_id": 20565,
                        "vendor_id": 12815
                    },
                    "simple_modifications": [
                        {
                            "from": { "key_code": "left_command" },
                            "to": [{ "key_code": "left_option" }]
                        },
                        {
                            "from": { "key_code": "left_option" },
                            "to": [{ "key_code": "left_command" }]
                        }
                    ]
                }
            ],
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }
    ]
